    maxFiles: 30,
    maxSize: "10m",
  },

  servers: [
    {
      host: "116.196.68.99",
      port: 22,
      username: "root",
      password: "ZYzx1357%",

      tasks: [
        // 增量备份：测试文件
        {
          name: "clash",
